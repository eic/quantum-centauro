#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)

prepare_run_directory() {
  local name=$1 value=${!1-} parent target
  [[ -n "$value" && "$value" == /* && "$value" != "/" && "$value" != *$'\n'* ]] || {
    printf '%s must be a non-root absolute path\n' "$name" >&2
    exit 2
  }
  if [[ -e "$value" || -L "$value" ]]; then
    [[ -d "$value" && ! -L "$value" ]] || { printf '%s must be a directory, not a symlink\n' "$name" >&2; exit 2; }
    RUN_DIR=$(cd -P -- "$value" && pwd -P)
  else
    parent=${value%/*}
    target=${value##*/}
    [[ -n "$parent" ]] || parent=/
    parent=$(cd -P -- "$parent" && pwd -P)
    [[ -n "$target" && "$target" != . && "$target" != .. ]] || { printf '%s has an invalid target name\n' "$name" >&2; exit 2; }
    mkdir -- "$parent/$target"
    RUN_DIR=$(cd -P -- "$parent/$target" && pwd -P)
  fi
  [[ "$RUN_DIR" != "/" && "$RUN_DIR" != *$'\n'* ]] || { printf '%s resolves to an unsafe path\n' "$name" >&2; exit 2; }
}

prepare_run_directory RUN_DIR
: "${PYTHON_BIN:?PYTHON_BIN must name the recipient Python executable}"
[[ "$PYTHON_BIN" != *$'\n'* && "$PYTHON_BIN" != -* ]] || {
  printf 'PYTHON_BIN is unsafe\n' >&2
  exit 2
}
[[ -d "$repo_root/../EICrecon" ]] || {
  printf 'sibling EICrecon checkout is unavailable\n' >&2
  exit 2
}

socket_path="$RUN_DIR/direct-centauro-worker.sock"
lifecycle_path="$RUN_DIR/direct-centauro-worker.lifecycle.json"
[[ ! -e "$socket_path" && ! -L "$socket_path" && ! -e "$lifecycle_path" && ! -L "$lifecycle_path" ]] || {
  printf 'worker socket or lifecycle already exists beneath RUN_DIR\n' >&2
  exit 2
}

exec "$PYTHON_BIN" -m eic_quantum.services.direct_centauro_quantum_worker \
  --socket "$socket_path" \
  --shots 512 \
  --exponent 3.0 \
  --seed 314159 \
  --max-candidates 128 \
  --lifecycle "$lifecycle_path"
