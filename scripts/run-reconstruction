#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ ${1-} == --mode ]]; then
  [[ $# == 2 ]] || { printf 'usage: %s [--mode] shadow|active\n' "${0##*/}" >&2; exit 2; }
  mode=$2
else
  [[ $# == 1 ]] || { printf 'usage: %s [--mode] shadow|active\n' "${0##*/}" >&2; exit 2; }
  mode=$1
fi
[[ "$mode" == shadow || "$mode" == active ]] || {
  printf 'usage: %s [--mode] shadow|active\n' "${0##*/}" >&2
  exit 2
}

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)

prepare_run_directory() {
  local name=$1 value=${!1-} parent target
  [[ -n "$value" && "$value" == /* && "$value" != / && "$value" != *$'\n'* ]] || {
    printf '%s must be a non-root absolute path\n' "$name" >&2
    exit 2
  }
  if [[ -e "$value" || -L "$value" ]]; then
    [[ -d "$value" && ! -L "$value" ]] || { printf '%s must be a directory, not a symlink\n' "$name" >&2; exit 2; }
    RUN_DIR=$(cd -P -- "$value" && pwd -P)
  else
    parent=${value%/*}
    target=${value##*/}
    [[ -n "$parent" ]] || parent=/
    parent=$(cd -P -- "$parent" && pwd -P)
    [[ -n "$target" && "$target" != . && "$target" != .. ]] || { printf '%s has an invalid target name\n' "$name" >&2; exit 2; }
    mkdir -- "$parent/$target"
    RUN_DIR=$(cd -P -- "$parent/$target" && pwd -P)
  fi
  [[ "$RUN_DIR" != / && "$RUN_DIR" != *$'\n'* ]] || { printf '%s resolves to an unsafe path\n' "$name" >&2; exit 2; }
}

prepare_run_directory RUN_DIR
require_absolute_directory() { local value=${!1-}; [[ -n "$value" && "$value" == /* && "$value" != / && "$value" != *$'\n'* ]]; }
require_absolute_directory INPUT_DIR || { printf 'INPUT_DIR must be a non-root absolute path\n' >&2; exit 2; }
: "${INPUT_BASENAME:?INPUT_BASENAME must be an exact examples/input_files.txt entry}"
: "${EICRECON_BIN:?EICRECON_BIN must name the recipient EICrecon executable}"
: "${EICRECON_TIMEOUT_MILLISECONDS:?EICRECON_TIMEOUT_MILLISECONDS is required}"
quantum_fail_closed=true
if [[ "$mode" == shadow ]]; then
  quantum_fail_closed=${QUANTUM_FAIL_CLOSED:-true}
fi
[[ "$EICRECON_BIN" != -* && "$EICRECON_BIN" != *$'\n'* && "$INPUT_BASENAME" != */* && "$INPUT_BASENAME" != *$'\n'* && "$EICRECON_TIMEOUT_MILLISECONDS" =~ ^[1-9][0-9]*$ ]] || {
  printf 'unsafe or invalid runtime input\n' >&2
  exit 2
}
[[ "$quantum_fail_closed" == true || "$quantum_fail_closed" == false ]] || {
  printf 'QUANTUM_FAIL_CLOSED must be true or false\n' >&2
  exit 2
}
grep -Fqx -- "$INPUT_BASENAME" "$repo_root/examples/input_files.txt" || {
  printf 'INPUT_BASENAME is not an approved fixture basename\n' >&2
  exit 2
}
[[ -f "$INPUT_DIR/$INPUT_BASENAME" && -S "$RUN_DIR/direct-centauro-worker.sock" ]] || {
  printf 'input or worker socket is unavailable\n' >&2
  exit 2
}

output_path="$RUN_DIR/$mode.edm4eic.root"
trace_path="$RUN_DIR/$mode.trace.jsonl"
[[ ! -e "$output_path" && ! -L "$output_path" && ! -e "$trace_path" && ! -L "$trace_path" ]] || {
  printf '%s output or trace already exists beneath RUN_DIR\n' "$mode" >&2
  exit 2
}
exec "$EICRECON_BIN" \
  -Pplugins=quantum_centauro \
  -Pnthreads=1 \
  -Pjana:parameter_strictness=2 \
  -PReco:ReconstructedDirectCentauroJets:quantumMode="qiskit_$mode" \
  -PReco:ReconstructedDirectCentauroJets:quantumSocketPath="$RUN_DIR/direct-centauro-worker.sock" \
  -PReco:ReconstructedDirectCentauroJets:quantumTimeoutMilliseconds="$EICRECON_TIMEOUT_MILLISECONDS" \
  -PReco:ReconstructedDirectCentauroJets:quantumShots=512 \
  -PReco:ReconstructedDirectCentauroJets:quantumExponentA=3.0 \
  -PReco:ReconstructedDirectCentauroJets:quantumSeed=314159 \
  -PReco:ReconstructedDirectCentauroJets:qiskitMaxCandidates=128 \
  -PReco:ReconstructedDirectCentauroJets:quantumTracePath="$trace_path" \
  -PReco:ReconstructedDirectCentauroJets:quantumFailClosed="$quantum_fail_closed" \
  -Ppodio:output_file="$output_path" \
  -Ppodio:output_collections=EventHeader,ReconstructedBreitFrameParticles,ReconstructedDirectCentauroJets \
  "$INPUT_DIR/$INPUT_BASENAME"
